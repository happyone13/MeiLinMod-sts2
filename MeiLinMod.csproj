<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <Sts2TargetVersion Condition="'$(Sts2TargetVersion)' == ''">110</Sts2TargetVersion>
        <!-- RitsuLib 0.5.0 adds the STS2 0.110 runtime variant and matching compile-time API. -->
        <RitsuLibVersion Condition="'$(RitsuLibVersion)' == ''">0.5.0</RitsuLibVersion>
    </PropertyGroup>

    <!-- OS Detection -->
    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <!-- // NOTE: Megadot is version 4.5.1, and the game won't load your .pck if the Godot version used is newer. -->

    <!-- Windows -->
    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <AutoSteamPath>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>

        <GodotPath>E:\SOFT\godot\Godot_v4.5.1-stable_mono_win64/Godot_v4.5.1-stable_mono_win64.exe</GodotPath>
        <!-- If on Windows and Slay the Spire 2 is not installed in your default steam library, adjust the following.-->
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps</SteamLibraryPath>

        <!-- Supported versions default to the installed Steam copy. Override via -p:Sts2PathXXX=... or STS2_XXX_PATH when needed. -->
        <Sts2Path103 Condition="'$(Sts2Path103)' == '' and '$(STS2_103_PATH)' != ''">$(STS2_103_PATH)</Sts2Path103>
        <Sts2Path103 Condition="'$(Sts2Path103)' == '' and Exists('$(SteamLibraryPath)/common/Slay the Spire 2')">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path103>
        <Sts2Path107 Condition="'$(Sts2Path107)' == '' and '$(STS2_107_PATH)' != ''">$(STS2_107_PATH)</Sts2Path107>
        <Sts2Path107 Condition="'$(Sts2Path107)' == '' and Exists('$(SteamLibraryPath)/common/Slay the Spire 2')">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path107>
        <Sts2Path108 Condition="'$(Sts2Path108)' == '' and '$(STS2_108_PATH)' != ''">$(STS2_108_PATH)</Sts2Path108>
        <Sts2Path108 Condition="'$(Sts2Path108)' == '' and Exists('$(SteamLibraryPath)/common/Slay the Spire 2')">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path108>
        <Sts2Path109 Condition="'$(Sts2Path109)' == '' and '$(STS2_109_PATH)' != ''">$(STS2_109_PATH)</Sts2Path109>
        <Sts2Path109 Condition="'$(Sts2Path109)' == '' and Exists('$(SteamLibraryPath)/common/Slay the Spire 2')">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path109>
        <Sts2Path110 Condition="'$(Sts2Path110)' == '' and '$(STS2_110_PATH)' != ''">$(STS2_110_PATH)</Sts2Path110>
        <Sts2Path110 Condition="'$(Sts2Path110)' == '' and Exists('$(SteamLibraryPath)/common/Slay the Spire 2')">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path110>
        <Sts2Path Condition="'$(Sts2TargetVersion)' == '103'">$(Sts2Path103)</Sts2Path>
        <Sts2Path Condition="'$(Sts2TargetVersion)' == '107'">$(Sts2Path107)</Sts2Path>
        <Sts2Path Condition="'$(Sts2TargetVersion)' == '108'">$(Sts2Path108)</Sts2Path>
        <Sts2Path Condition="'$(Sts2TargetVersion)' == '109'">$(Sts2Path109)</Sts2Path>
        <Sts2Path Condition="'$(Sts2TargetVersion)' == '110'">$(Sts2Path110)</Sts2Path>
        <LocalModsDirName Condition="'$(LocalModsDirName)' == '' and Exists('$(Sts2Path)/mods2')">mods2</LocalModsDirName>
        <LocalModsDirName Condition="'$(LocalModsDirName)' == ''">mods</LocalModsDirName>
        <ModsPath>$(Sts2Path)/$(LocalModsDirName)/</ModsPath>
        <LegacyModsPath>$(Sts2Path)/mods/</LegacyModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- Linux -->
    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <SteamLibraryPath>$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
        <!-- Change the path here if using a downloaded binary instead of the Steam version-->
        <GodotPath>$(SteamLibraryPath)/common/Godot Engine/godot.x11.opt.tools.64</GodotPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <LocalModsDirName Condition="'$(LocalModsDirName)' == '' and Exists('$(Sts2Path)/mods2')">mods2</LocalModsDirName>
        <LocalModsDirName Condition="'$(LocalModsDirName)' == ''">mods</LocalModsDirName>
        <ModsPath>$(Sts2Path)/$(LocalModsDirName)/</ModsPath>
        <LegacyModsPath>$(Sts2Path)/mods/</LegacyModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- macOS -->
    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath>$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <GodotPath>$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>

        <!-- The below should not need to be changed. -->
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
        <DefineConstants Condition="'$(Sts2TargetVersion)' == '103'">$(DefineConstants);STS2_103</DefineConstants>
        <DefineConstants Condition="'$(Sts2TargetVersion)' == '107'">$(DefineConstants);STS2_107</DefineConstants>
        <DefineConstants Condition="'$(Sts2TargetVersion)' == '108'">$(DefineConstants);STS2_108</DefineConstants>
        <DefineConstants Condition="'$(Sts2TargetVersion)' == '109'">$(DefineConstants);STS2_109</DefineConstants>
        <DefineConstants Condition="'$(Sts2TargetVersion)' == '110'">$(DefineConstants);STS2_110</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)') and '$(Configuration)' == 'Debug'">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)') and '$(Configuration)' != 'Debug'">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="STS2.RitsuLib" Version="$(RitsuLibVersion)" GeneratePathProperty="true" PrivateAssets="All" />
        <AdditionalFiles Include="MeiLinMod/localization/**/*.json" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="MeiLinMod/**" />
        <Compile Remove=".godot/**" />
        <Compile Remove="tmp/**" />
        <Compile Remove="tests/**" />
        <Compile Remove="tools/**" />
        <Compile Remove="materials/**" />
        <Compile Remove="shaders/**" />
        <Compile Remove="images/**" />
        <EmbeddedResource Remove="MeiLinMod/**" />
        <EmbeddedResource Remove=".godot/**" />
        <EmbeddedResource Remove="tmp/**" />
        <EmbeddedResource Remove="tests/**" />
        <EmbeddedResource Remove="tools/**" />
        <EmbeddedResource Remove="materials/**" />
        <EmbeddedResource Remove="shaders/**" />
        <EmbeddedResource Remove="images/**" />
        <None Remove="tmp/**" />
        <None Remove="tests/**" />
        <None Remove="MeiLinMod/newcard/**" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore" />
        <None Include="MeiLinMod.json" />
        <None Include="project.godot" />
        <None Include="MeiLinMod/**" Exclude="MeiLinMod/newcard/**" />
    </ItemGroup>

    <ItemGroup>
      <Content Include=".godot\mono\temp\obj\Debug\MeiLinMod.csproj.Up2Date" />
    </ItemGroup>

    <ItemGroup>
        <GodotExportIgnoreMarker Include="addons\auto_spine_skel_data\.gdignore" />
        <GodotExportIgnoreMarker Include="addons\godot_mcp_server\.gdignore" />
        <GodotExportIgnoreMarker Include="addons\spine_speed_inspector\.gdignore" />
        <GodotExportIgnoreMarker Include="tools\.gdignore" />
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error Text=" Unsupported Sts2TargetVersion '$(Sts2TargetVersion)'. Use 103, 107, 108, 109, or 110." Condition="'$(Sts2TargetVersion)' != '103' and '$(Sts2TargetVersion)' != '107' and '$(Sts2TargetVersion)' != '108' and '$(Sts2TargetVersion)' != '109' and '$(Sts2TargetVersion)' != '110'" />
        <Error Text=" Sts2Path103 is not configured. Pass -p:Sts2Path103=&lt;path&gt; or set STS2_103_PATH when building 103." Condition="'$(Sts2TargetVersion)' == '103' and '$(Sts2Path103)' == ''" />
        <Error Text=" Sts2Path107 is not configured. Pass -p:Sts2Path107=&lt;path&gt; or set STS2_107_PATH when building 107." Condition="'$(Sts2TargetVersion)' == '107' and '$(Sts2Path107)' == ''" />
        <Error Text=" Sts2Path108 is not configured. Pass -p:Sts2Path108=&lt;path&gt; or set STS2_108_PATH when building 108." Condition="'$(Sts2TargetVersion)' == '108' and '$(Sts2Path108)' == ''" />
        <Error Text=" Sts2Path109 is not configured. Pass -p:Sts2Path109=&lt;path&gt; or set STS2_109_PATH when building 109." Condition="'$(Sts2TargetVersion)' == '109' and '$(Sts2Path109)' == ''" />
        <Error Text=" Sts2Path110 is not configured. Pass -p:Sts2Path110=&lt;path&gt; or set STS2_110_PATH when building 110." Condition="'$(Sts2TargetVersion)' == '110' and '$(Sts2Path110)' == ''" />
        <Error Text=" Slay the Spire 2 $(Sts2TargetVersion) data not found at path '$(Sts2DataDir)'" Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
        <Error Text=" Godot not found at path '$(GodotPath)'" Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')" />
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
        <Message Text="Copying .dll and manifest to mods folder." Importance="high" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="MeiLinMod.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LegacyModsPath)$(MSBuildProjectName)/" Condition="'$(LegacyModsPath)' != '' and '$(LegacyModsPath)' != '$(ModsPath)'" />
        <Copy SourceFiles="MeiLinMod.json" DestinationFolder="$(LegacyModsPath)$(MSBuildProjectName)/" Condition="'$(LegacyModsPath)' != '' and '$(LegacyModsPath)' != '$(ModsPath)'" />
    </Target>

    <Target Name="MirrorGodotPackToLegacyModsFolder" AfterTargets="GodotPackOnBuild;GodotPublish" Condition="'$(LegacyModsPath)' != '' and '$(LegacyModsPath)' != '$(ModsPath)' and Exists('$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck')">
        <Message Text="Mirroring Godot .pck to legacy mods folder for test loaders" Importance="high" />
        <Copy SourceFiles="$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck" DestinationFolder="$(LegacyModsPath)$(MSBuildProjectName)/" />
    </Target>

    <Target Name="CreateGodotExportIgnoreMarkers" BeforeTargets="GodotPackOnBuild;GodotPublish">
        <WriteLinesToFile File="%(GodotExportIgnoreMarker.Identity)" Lines="Generated during MSBuild export to keep development-only tools out of the PCK." Overwrite="true" />
    </Target>

    <Target Name="DeleteGodotExportIgnoreMarkers" AfterTargets="GodotPackOnBuild;GodotPublish">
        <Delete Files="@(GodotExportIgnoreMarker)" TreatErrorsAsWarnings="true" />
    </Target>

    <Target Name="GodotPackOnBuild" AfterTargets="Build" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder on Build" Importance="high" />
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;" EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;STS2_103_PATH=$(Sts2Path103);STS2_107_PATH=$(Sts2Path107);STS2_108_PATH=$(Sts2Path108);STS2_109_PATH=$(Sts2Path109);STS2_110_PATH=$(Sts2Path110)" ContinueOnError="WarnAndContinue" />
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder" Importance="high" />
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;" EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;STS2_103_PATH=$(Sts2Path103);STS2_107_PATH=$(Sts2Path107);STS2_108_PATH=$(Sts2Path108);STS2_109_PATH=$(Sts2Path109);STS2_110_PATH=$(Sts2Path110)" ContinueOnError="WarnAndContinue" />
    </Target>

    <Target Name="GodotPublishSkipped" AfterTargets="Publish" Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')">
        <Message Text="Skipping Godot .pck export because GodotPath is not configured." Importance="high" />
    </Target>
</Project>
